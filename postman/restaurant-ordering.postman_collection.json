{
  "info": {
    "name": "Restaurant Ordering System",
    "_postman_id": "b8ab81a8-7847-4dbc-b155-7b7c9244670e",
    "description": "Sample requests for the QR-based restaurant ordering backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Menu",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/menu?tableId={{tableId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu"
          ],
          "query": [
            {
              "key": "tableId",
              "value": "{{tableId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Place Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Idempotency-Key",
            "value": "demo-order-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tableId\": \"{{tableId}}\",\n  \"customerName\": \"Rahul\",\n  \"items\": [\n    {\n      \"menuItemId\": \"{{menuItemId1}}\",\n      \"quantity\": 2\n    },\n    {\n      \"menuItemId\": \"{{menuItemId2}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "Get Orders For Table",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders?tableId={{tableId}}&page=0&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ],
          "query": [
            {
              "key": "tableId",
              "value": "{{tableId}}"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Update Order Status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Restaurant-Id",
            "value": "{{restaurantId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PREPARING\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}",
            "status"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "restaurantId",
      "value": ""
    },
    {
      "key": "tableId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "menuItemId1",
      "value": ""
    },
    {
      "key": "menuItemId2",
      "value": ""
    }
  ]
}
