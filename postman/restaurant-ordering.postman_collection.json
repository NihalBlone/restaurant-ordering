{
  "info": {
    "name": "Restaurant Ordering System",
    "_postman_id": "b8ab81a8-7847-4dbc-b155-7b7c9244670e",
    "description": "Sample requests for the QR-based restaurant ordering backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(pm.request.method)) {",
          "  pm.sendRequest(pm.variables.get('baseUrl') + '/api/auth/csrf', (error, response) => {",
          "    if (error || response.code !== 200) { throw new Error('Unable to obtain CSRF token'); }",
          "    const csrf = response.json();",
          "    pm.request.headers.upsert({ key: csrf.headerName, value: csrf.token });",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Platform Owner Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"{{platformUsername}}\",\"password\":\"{{platformPassword}}\",\"code\":\"{{platformTotp}}\"}" },
        "url": "{{baseUrl}}/api/auth/platform-login"
      }
    },
    {
      "name": "Platform Overview",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/overview" }
    },
    {
      "name": "Platform Restaurants",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/restaurants?search=&page=0" }
    },
    {
      "name": "Restaurant Admin Login",
      "request": {
        "method": "POST",
        "header": [
