# Reference only. Render prompts for secrets; do not commit a populated copy.
# For a non-Render host, use prod and a JDBC URL (not postgres://).
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/restaurant_ordering?sslmode=verify-full
DATABASE_USERNAME=restaurant_app
DATABASE_PASSWORD=REPLACE_IN_SECRET_STORE
APP_CUSTOMER_BASE_URL=https://orders.YOUR_DOMAIN.com
APP_WEBSOCKET_ALLOWED_ORIGINS=https://orders.YOUR_DOMAIN.com
APP_AUTH_JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_PLATFORM_USERNAME=owner
APP_PLATFORM_EMAIL=YOUR_REAL_OWNER_EMAIL
APP_PLATFORM_PASSWORD=REPLACE_WITH_UNIQUE_14_TO_72_BYTE_PASSWORD
APP_PLATFORM_TOTP_SECRET=REPLACE_WITH_32_CHARACTER_BASE32_SECRET
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
APP_MAIL_FROM=noreply@YOUR_VERIFIED_DOMAIN.com
APP_MENU_IMAGE_DIRECTORY=/var/data/menu-images
